# AetherSwap 环境变量示例
# 复制为 .env 后按需修改；不要在其中保存或提交代理凭据等敏感信息。

# 运行数据目录。留空或注释时使用仓库根目录下的 config/。
# 相对路径按启动命令的当前工作目录解析。
# AETHERSWAP_DATA_DIR=./config

# Web 服务监听地址和端口。
# 使用 0.0.0.0 可供局域网设备访问，但不要直接暴露到公网。
AETHERSWAP_HOST=127.0.0.1
AETHERSWAP_PORT=28472

# Playwright 使用的宿主浏览器：chrome、msedge 或 chromium。
AETHERSWAP_BROWSER_CHANNEL=chrome

# 启动时若前端源码比 web/dist 新，自动执行一次 npm --prefix web run build。
# 设为 0 可关闭（例如部署环境只带预构建产物、不安装 Node.js）。
# AETHERSWAP_WEB_BUILD=1

# 可选：访问 Steam 等外部服务时使用的代理。
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1
